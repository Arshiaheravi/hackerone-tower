# Copy to .env. Never commit or paste credentials into chat.
H1_USERNAME=your_hackerone_username
H1_API_TOKEN=
TELEGRAM_BOT_TOKEN=
# Channel username (@your_channel) or numeric channel ID. Bot must be an admin.
# Leave empty to use personal opt-in bot subscriptions only.
TELEGRAM_CHANNEL_ID=
# Optional private owner chat ID for health notifications.
TELEGRAM_ADMIN_CHAT_ID=
TOWER_DATABASE=data/tower.sqlite3
TOWER_LOG_DIR=logs
CATALOG_INTERVAL_SECONDS=120
SCOPE_REFRESH_SECONDS=900
# One shared request budget; a slow program can leave the other worker available.
SCOPE_WORKERS=2
H1_REQUESTS_PER_MINUTE=300
H1_SCOPE_REQUESTS_PER_MINUTE=40
RETENTION_DAYS=90
ENABLE_PERSONAL_BOT=true
